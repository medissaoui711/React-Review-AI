{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "react-review-ai-local": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/index.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}/server",
      "env": {
        "REACT_REVIEW_ROOT": "${REACT_REVIEW_ROOT}"
      }
    }
  }
}
